rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Each person's private data (checklist entries, encrypted diary, groups
    // they belong to). Only they can read or write it.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Aggregated counts for week/month/year awards. Members can read rows only
    // when the row belongs to one of their groups. The app owner can also read
    // the overall leaderboard.
    match /leaderboard/{docId} {
      allow read: if request.auth != null && (
        request.auth.token.email == 'jervene.venturina@gmail.com'
        || (resource.data.groupIds is list
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.groupIds is list
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.groupIds.hasAny(resource.data.groupIds))
      );
      allow write: if request.auth != null
        && request.auth.uid == request.resource.data.uid
        && docId.matches('.*_' + request.auth.uid);
    }

    // Groups (e.g. departments). Signed-in users can list, create and join
    // them. Only the person who created a group can add or remove its custom
    // checklist items, and only the "items" field is ever allowed to change —
    // the name and owner are locked in at creation.
    match /groups/{groupId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.items is list
        && request.resource.data.items.size() == 0;
      allow update: if request.auth != null
        && request.auth.uid == resource.data.createdBy
        && request.resource.data.name == resource.data.name
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 10;
      allow delete: if false;
    }

    // Web Push subscriptions for the 8 PM reminder. A person can only see or
    // remove their own device's subscription. The reminder server itself
    // reads this collection with an admin service account, which bypasses
    // these rules entirely, so it can still deliver notifications.
    match /pushSubscriptions/{docId} {
      allow read, delete: if request.auth != null && request.auth.uid == resource.data.uid;
      allow create, update: if request.auth != null
        && request.auth.uid == request.resource.data.uid
        && docId.matches('.*_' + request.auth.uid);
    }
  }
}
