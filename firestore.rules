rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Each person's private data (checklist entries, encrypted diary, groups).
    // Only they can read or write it.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Aggregated counts for week/month/year awards. Anyone signed in can read
    // (to build leaderboards); people can only write their own row.
    match /leaderboard/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == request.resource.data.uid
        && docId.matches('.*_' + request.auth.uid);
    }

    // Groups (e.g. departments). Signed-in users can list, create and join
    // them. Groups can't be edited or deleted once created.
    match /groups/{groupId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60;
      allow update, delete: if false;
    }
  }
}
